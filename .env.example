# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/welcome
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/welcome

# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# Convex <> Clerk integration
# Set this to the "Issuer" URL of the "convex" JWT template in your Clerk dashboard
CLERK_JWT_ISSUER_DOMAIN=

# Clerk webhook signing secret (also set on Convex deployment)
CLERK_WEBHOOK_SECRET=

# Anthropic / Claude (server-side only)
ANTHROPIC_API_KEY=

# Firecrawl (server-side only)
FIRECRAWL_API_KEY=

# Polar (later)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
