# =====================================================================
# Vibeify env vars
#
# For LOCAL DEV: copy to .env.local and fill in.
# For VERCEL: set the variables marked [vercel] in the Vercel dashboard
#   (Project → Settings → Environment Variables). The Convex variables
#   marked [convex] go on the Convex deployment via:
#     npx convex env set --prod KEY value
# =====================================================================

# ─── Clerk ───────────────────────────────────────────────────────────
# [vercel] Get from https://dashboard.clerk.com → API keys
# Use pk_test_/sk_test_ for dev, pk_live_/sk_live_ for the prod instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# [vercel + convex] Issuer URL of the "convex" JWT template (Clerk → JWT templates)
CLERK_JWT_ISSUER_DOMAIN=

# [convex] Webhook signing secret (Clerk → Webhooks → endpoint → Signing Secret)
# Only needed if you wired up the user-sync webhook (optional).
CLERK_WEBHOOK_SECRET=

# Clerk redirect routes (rarely changed)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/welcome
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/welcome

# ─── Convex ──────────────────────────────────────────────────────────
# Local dev: auto-written by `npx convex dev`.
# [vercel] In production set NEXT_PUBLIC_CONVEX_URL only — and CONVEX_DEPLOY_KEY
# if you use the atomic-deploy build command (see README).
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# [vercel, CI only] Generated in Convex dashboard → Settings → Deploy Keys.
# Required if your Vercel build runs `npx convex deploy --cmd 'next build'`.
CONVEX_DEPLOY_KEY=

# ─── Anthropic / Claude (server-side only) ───────────────────────────
# [vercel + convex] Used by both Next route /api/claude/chat AND Convex Node
# actions (aiStack, aiKnowledge, aiFeatures). Set in both places.
ANTHROPIC_API_KEY=

# ─── Firecrawl (server-side only) ────────────────────────────────────
# [convex] Used by the convex/firecrawl.ts action. Set on Convex only.
FIRECRAWL_API_KEY=

# ─── App ─────────────────────────────────────────────────────────────
# [vercel] e.g. https://app.your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Polar (deferred — Phase 13) ─────────────────────────────────────
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
